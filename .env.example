# =============================================================================
# AutoScientist-ETFT — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Coding-Agent Proxy (primary LLM access path)
# ---------------------------------------------------------------------------
# The ETFT framework never calls LLM provider APIs directly.
# All LLM traffic goes through the coding-agent proxy container.

# Where the proxy is reachable (local container or cloud endpoint):
AGENT_PROXY_URL=http://localhost:8080

# Shared secret the ETFT client sends in X-Agent-Token:
AGENT_PROXY_TOKEN=change-me-in-production

# ---------------------------------------------------------------------------
# Inside the proxy container — provider credentials (set in container env)
# ---------------------------------------------------------------------------
# These are consumed by docker/agent/server.py, NOT by the ETFT framework itself.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which backend the proxy server uses: "openai" | "anthropic" | "local"
PROXY_LLM_BACKEND=openai
PROXY_LLM_MODEL=gpt-4o

# For local models inside the container (vLLM / Ollama):
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# ---------------------------------------------------------------------------
# GPU Cluster / Physical Evaluation
# ---------------------------------------------------------------------------
GPU_CLUSTER_ENDPOINT=https://your-cluster-endpoint/api
GPU_CLUSTER_API_KEY=your-cluster-key

# ---------------------------------------------------------------------------
# Data paths (override config.yaml defaults if needed)
# ---------------------------------------------------------------------------
DATA_ROOT=./data

# ChromaDB persistence directory for the RAG vector store.
# Set vector_store.backend to "chroma" in config.yaml and install
# autoscientist-etft[rag] to enable cross-run knowledge accumulation.
VECTOR_STORE_PERSIST_DIR=./data/vector_store

# ---------------------------------------------------------------------------
# Fine-tuning (HuggingFace PEFT / LoRA)
# ---------------------------------------------------------------------------
HF_TOKEN=hf_...
HF_BASE_MODEL=meta-llama/Meta-Llama-3-8B

# OpenAI fine-tune endpoint (alternative path)
OPENAI_FINETUNE_MODEL=gpt-3.5-turbo

# ---------------------------------------------------------------------------
# Observability — MLflow + ChromaDB (docker compose --profile observability)
# ---------------------------------------------------------------------------
# MLflow tracking server URI.  When running the observability compose profile,
# set this to the MLflow container URL so run_logger.py sends metrics there.
MLFLOW_TRACKING_URI=http://localhost:5000
