# =============================================================================
# AutoScientist-ETFT — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# =============================================================================

# --- LLM Provider (set ONE of the following) ---------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which backend to use: "openai" | "anthropic" | "local"
LLM_BACKEND=openai

# Model identifiers
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# For local models (e.g. vLLM / Ollama):
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# --- GPU Cluster / Physical Evaluation ---------------------------------------
GPU_CLUSTER_ENDPOINT=https://your-cluster-endpoint/api
GPU_CLUSTER_API_KEY=your-cluster-key

# --- arXiv / Semantic Scholar ------------------------------------------------
# arXiv requires no key, but Semantic Scholar has a rate-limited free tier.
SEMANTIC_SCHOLAR_API_KEY=

# --- Data paths (override config.yaml defaults if needed) --------------------
DATA_ROOT=./data

# --- Fine-tuning (HuggingFace) -----------------------------------------------
HF_TOKEN=hf_...
HF_BASE_MODEL=meta-llama/Meta-Llama-3-8B
