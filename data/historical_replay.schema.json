{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luke-b/AutoScientist-ETFT/data/historical_replay.schema.json",
  "title": "ETFT Historical Replay Transition",
  "description": "A provenance-aware record for one historically realized transition A_i -> A_(i+1).",
  "type": "object",
  "required": [
    "trajectory_id",
    "transition_id",
    "predecessor",
    "successor",
    "bottleneck",
    "intervention",
    "outcome",
    "provenance"
  ],
  "properties": {
    "trajectory_id": {"type": "string"},
    "transition_id": {"type": "string"},
    "domain": {"type": "string"},
    "timestamp_or_release": {"type": ["string", "null"]},
    "predecessor": {
      "type": "object",
      "required": ["artifact_id"],
      "properties": {
        "artifact_id": {"type": "string"},
        "source_ref": {"type": ["string", "null"]},
        "code_path": {"type": ["string", "null"]},
        "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}}
      },
      "additionalProperties": true
    },
    "successor": {
      "type": "object",
      "required": ["artifact_id"],
      "properties": {
        "artifact_id": {"type": "string"},
        "source_ref": {"type": ["string", "null"]},
        "code_path": {"type": ["string", "null"]},
        "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}}
      },
      "additionalProperties": true
    },
    "bottleneck": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "intervention": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string"},
        "components_changed": {"type": "array", "items": {"type": "string"}},
        "diff_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "rationale": {
      "type": "object",
      "properties": {
        "summary": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "failed_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "summary": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["summary"]
      }
    },
    "outcome": {
      "type": "object",
      "required": ["metrics"],
      "properties": {
        "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}},
        "delta": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}},
        "benchmark_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "curation_notes": {"type": ["string", "null"]},
        "license_notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "split": {
      "type": "string",
      "enum": ["train", "calibration", "test", "frontier"]
    }
  },
  "additionalProperties": false
}
